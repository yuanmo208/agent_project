# ============ 第一阶段：构建（deploy-vue 项目） ============
FROM node:20-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制依赖清单（利用 Docker 缓存层：依赖不变时跳过安装）
# 项目中有 package-lock.json，npm ci 必须依赖它
COPY package.json package-lock.json ./

# 安装全部依赖（含 vite 等 devDependencies，构建必需）
RUN npm ci

# 复制源代码（src / public / index.html / vite.config.js）
COPY . .

# 构建生产版本（Vite 默认输出到 dist）
RUN npm run build

# ============ 第二阶段：运行 ============
FROM nginx:alpine

# 从构建阶段复制产物到 Nginx 站点目录
COPY --from=builder /app/dist /usr/share/nginx/html

# 复制自定义 Nginx 配置（覆盖默认配置）
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口（实际映射在运行时用 -p 指定）
EXPOSE 8080

# 前台运行 Nginx（容器必需）
CMD ["nginx", "-g", "daemon off;"]